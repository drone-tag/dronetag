{
  "name": "drone-tag",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/stage-vendor-assets.mjs",
    "predev": "node scripts/stage-vendor-assets.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/stage-vendor-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.mts\"",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "grant-admin": "tsx --env-file=.env.local scripts/grant-admin.ts",
    "backfill-public": "tsx --env-file=.env.local scripts/backfill-drones-public.ts"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "firebase-admin": "^14.2.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-firebase-hooks": "^5.1.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "minimatch": "^10.1.1",
    "sharp": "^0.35.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
