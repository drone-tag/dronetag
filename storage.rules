rules_version = '2';

// DroneTag — Firebase Storage rules.
//
// ─── Pre-beta hardening: what changed and why ──────────────────────────────
//
// The previous version of this file granted `allow read: if true` on
// `users/{uid}/{allPaths=**}`. Every uploaded object — insurance policies,
// identity documents, pilot certificates — was readable by anyone who could
// name its path, with no authentication at all (finding SEC-006). The
// justification recorded at the time was that "download URL tokens are public
// anyway". That reasoning conflated two different things:
//
//   • A `getDownloadURL()` token URL bypasses these rules by design. Anyone
//     holding that URL can fetch the object. That is expected.
//   • A *rule* granting public read additionally allows fetching any object
//     by path WITHOUT a token. Paths here are highly guessable
//     (`users/{uid}/insurances/{insuranceId}/policy.pdf`), so the rule turned
//     a leaked-URL risk into a direct-enumeration risk.
//
// Removing the public read does not break existing pages: URLs already stored
// in Firestore keep working, because tokens bypass rules either way. What it
// stops is unauthenticated traversal of the private namespace.
//
// ─── Namespace layout ──────────────────────────────────────────────────────
//
//   public/users/{uid}/...   world-readable. Images only. Branding assets
//                            that genuinely appear on the anonymous profile
//                            page: avatar, logo, banner, QR code.
//
//   users/{uid}/...          private. Owner and admin only. Insurance PDFs,
//                            certificates, identity documents.
//
// The two namespaces do not overlap, so the private rule cannot be widened by
// accident through an OR with the public one. Storage rules grant access when
// ANY matching rule allows it, which is exactly why nesting `public/` inside
// `users/{uid}/` would have been unsafe: the broad private rule would have
// re-allowed PDF writes into the public subtree.
//
// Content types are also asymmetric on purpose: the public namespace accepts
// images only, so the product cannot end up hosting arbitrary
// anonymously-readable PDFs.
//
// Still open (tracked, not fixed here):
//   * App Check is not enforced on Storage.
//   * Objects orphaned by entity deletion are not garbage-collected.

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ─────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // See the matching helper in firestore.rules: `.admin` on a token that
      // carries no such claim is an evaluation error, not `false`. Here the
      // helper does sit to the left of an `&&` (the admin write rules below),
      // where an error and a `false` still agree, but only because the rule is
      // admin-only to begin with.
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/png|image/jpeg|image/webp');
    }
    function isImageOrPdf() {
      // SVG stays out: it can carry script that executes on the storage
      // origin when opened directly (V-013).
      return request.resource.contentType.matches(
        'application/pdf|image/png|image/jpeg|image/webp'
      );
    }
    function isWithinImageSize() {
      return request.resource.size <= 20 * 1024 * 1024;
    }
    function isWithinFileSize() {
      // 50 MB hard cap, mirroring DIRECT_MAX_BYTES in
      // src/lib/client/fileUpload.ts and MAX_UPLOAD_BYTES on the server.
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // ─── Public branding namespace ───────────────────────────────────────
    // Anonymous read is intentional here: these assets render on /u/{slug}
    // for a visitor who has just tapped an NFC badge. Images only, 20 MB.
    match /public/users/{uid}/{allPaths=**} {
      allow read: if true;

      allow write: if isOwner(uid) && isImage() && isWithinImageSize();
      allow write: if isAdmin() && isImage() && isWithinImageSize();

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── Private user namespace ──────────────────────────────────────────
    // Insurance policies, certificates and identity documents. Never
    // anonymously readable.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();

      allow write: if isOwner(uid) && isImageOrPdf() && isWithinFileSize();
      allow write: if isAdmin() && isImageOrPdf() && isWithinFileSize();

      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── Legacy profiles namespace ───────────────────────────────────────
    // Pre-multi-entity uploads at `profiles/{slug}/...`. Read was public;
    // it is now admin-only. Legacy pages render from download URLs already
    // persisted in Firestore, which are unaffected. New uploads must use
    // one of the two namespaces above.
    match /profiles/{path=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isImageOrPdf() && isWithinFileSize();
      allow delete: if isAdmin();
    }

    // ─── Default deny ────────────────────────────────────────────────────
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
